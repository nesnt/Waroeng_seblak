# ==========================================
# UMKM WhatsApp AI Agent - Environment Configuration
# Waroeng Seblak 48
# ==========================================

# Port Server Express (Health Check & Webhook)
PORT=5000
NODE_ENV=development

# Google Gemini API
# Dapatkan API Key di Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Supabase Configuration
# Gunakan SUPABASE_SERVICE_ROLE_KEY untuk akses backend query langsung
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Nomor Telepon Owner / Pemilik Warung (pisahkan dengan koma jika lebih dari satu)
# Format internasional tanpa simbol + atau spasi, contoh: 628123456789,628987654321
OWNER_PHONE_NUMBERS=628123456789,628987654321

# Direktori Penyimpanan Sesi WhatsApp Baileys
SESSION_DATA_PATH=./baileys_auth_info

# Info Warung Tambahan (Opsional)
STORE_NAME="Waroeng Seblak 48"
STORE_ADDRESS="Jl. Raya Sukaresmi No. 48, Bandung"
STORE_HOURS="Setiap Hari, 10:00 - 22:00 WIB"
BROCHURE_URL="https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=800&q=80"

